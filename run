#!/bin/bash
# Two-party local test harness. The port travels via EMP_PORT (read by
# peer_port()); only the party id is a positional arg. It is EMP_PORT when set
# (ctest gives each two-party test its own) and 12345 otherwise: a fixed port
# below the range the OS assigns to outgoing connections (32768 and up on Linux,
# 49152 and up on macOS), so no outgoing connection can be holding it. The
# listener sets SO_REUSEADDR, so back-to-back runs can re-bind it.
export EMP_PORT=${EMP_PORT:-12345}
if [ "$1" == "-p1" ]
then
   shift
   perf record  $1 1 & (sleep 0.1;  $1 2)
elif [ "$1" == "-p2" ]
then
   shift
   (sleep 0.1; $1 1) & (perf record $1 2)

elif [ "$1" == "-m1" ]
then
   shift
   valgrind --leak-check=full $1 1 & $1 2
elif [ "$1" == "-m2" ]
then
   shift
   $1 1 & valgrind --leak-check=full $1 2
elif [ "$1" == "-t1" ]
then
   shift
   time $1 1 & $1 2
elif [ "$1" == "-t2" ]
then
   shift
   $1 1 & time $1 2

else
  (sleep 0.05; $1 1) &  $1 2
fi
